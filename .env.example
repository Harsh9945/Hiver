# Environment Configuration for AI Support Agent
# ==============================================================================
# Copy this file to .env and fill in your actual API credentials:
#   cp .env.example .env
#
# NOTE: The evaluation suite runs 100% deterministically in offline mode
# without any API key:
#   python eval/run_eval.py --sample-size 200 --mode offline
# ==============================================================================

# Option A: Groq (Recommended: 100% Free, high throughput, zero PC load)
# Get a free API key at: https://console.groq.com/keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=groq/compound

# Option B: OpenAI API
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option C: Google Gemini (OpenAI-compatible endpoint)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your_gemini_api_key_here
# OPENAI_MODEL=gemini-2.5-flash

# Option D: Local Ollama (Local open-weights)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b
